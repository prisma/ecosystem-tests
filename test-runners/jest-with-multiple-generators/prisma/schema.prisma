generator client {
  provider = "prisma-client"
  output   = "../generated1"
}

generator client2 {
  provider = "prisma-client"
  output   = "../generated2"
  // TODO Test what happens if _one_ of these has the preview feature enabled, but not the other one
}

datasource db {
  provider = "sqlite"
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
}
